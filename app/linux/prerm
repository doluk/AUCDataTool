#
# .deb prerm ("remove") / .rpm %preun ("0" on erase): remove the links made by postinst.
# Upgrades keep them (postinst of the new version sets them again).
set -e
case "$1" in
    remove|0)
        ID=io.github.doluk.AUCDataTool
        rm -f /usr/bin/AUCDataTool "/usr/share/applications/$ID.desktop" \
              "/usr/share/icons/hicolor/scalable/apps/$ID.svg"
        if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database -q /usr/share/applications || true; fi
        ;;
esac
exit 0
