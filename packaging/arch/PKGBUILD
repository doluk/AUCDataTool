# Builds from the enclosing source tree against system Qt:
#   cd packaging/arch && makepkg -s

pkgname=aucdatatool
pkgver=0.1.0
pkgrel=1
pkgdesc="Viewer for analytical ultracentrifugation raw data"
arch=('x86_64' 'aarch64')
url="https://github.com/doluk/AUCDataTool"
license=('LGPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-graphs' 'qt6-quick3d')
makedepends=('cmake' 'ninja')
options=('!debug')

_srcroot="$(realpath "${startdir}/../..")"

pkgver() {
    sed -nE 's/^[[:space:]]*VERSION ([0-9][0-9.]*)$/\1/p' "${_srcroot}/CMakeLists.txt" | head -n1
}

build() {
    cmake -S "${_srcroot}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DAUC_DEPLOY_QT=OFF \
        -DAUC_BUILD_TESTS=OFF \
        -DAUC_BUILD_TOOLS=OFF
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 "${_srcroot}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
